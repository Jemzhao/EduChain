EDUCHAIN_EVIDENCE_MODE=simulator
EDUCHAIN_EVIDENCE_DEPLOYMENT_ENVIRONMENT=local
EDUCHAIN_EVIDENCE_SERVICE_VERSION=0.1.0
EDUCHAIN_EVIDENCE_DATA_PATH=./data/evidence-simulator.sqlite3
EDUCHAIN_EVIDENCE_LOG_LEVEL=INFO
EDUCHAIN_EVIDENCE_INTERNAL_SERVICE_TOKEN=replace-with-at-least-32-random-characters
EDUCHAIN_EVIDENCE_PUBLIC_BASE_URL=http://localhost:3000
EDUCHAIN_EVIDENCE_CERTIFICATE_STORAGE_PATH=./data/certificates
# Optional override; the container already includes Noto Sans CJK.
# EDUCHAIN_EVIDENCE_CERTIFICATE_FONT_PATH=/run/secrets/NotoSansCJKsc-Regular.otf
EDUCHAIN_EVIDENCE_SIMULATOR_SCENARIO=instant
EDUCHAIN_EVIDENCE_SIMULATOR_CONFIRMATION_DELAY_SECONDS=2
